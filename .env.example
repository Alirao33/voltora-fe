# Where the Voltora FastAPI backend runs. Requests from the browser go to /api-proxy/*
# and Next.js forwards them here (no CORS setup needed on the backend).
VOLTORA_API_URL=http://localhost:8000

# Optional: call the backend directly from the browser instead of through the proxy
# (requires CORS on the backend). Leave unset to use the proxy.
# NEXT_PUBLIC_API_BASE=https://api.voltora.pk
